{
  "scenario_id": "scenario-a-inbound",
  "name": "Inbound Message Handler",
  "version": "2.0.0",
  "status": "production",
  "trigger_type": "webhook",
  "schedule": null,
  "dependencies": {
    "upstream": ["360dialog"],
    "downstream": ["scenario-b-state-engine", "scenario-e-dlq"],
    "data_stores": ["DS_PROCESSED_MESSAGES"],
    "airtable_tables": ["People", "Work_Items", "Interaction_Logs"]
  },
  "env_vars": {
    "MAKE_WEBHOOK_URL_SCENARIO_A": {
      "description": "This scenario's webhook URL",
      "required": true
    },
    "MAKE_WEBHOOK_URL_SCENARIO_B": {
      "description": "State Engine webhook URL",
      "required": true
    },
    "MAKE_WEBHOOK_URL_SCENARIO_E": {
      "description": "Error Handler webhook URL",
      "required": true
    },
    "360DIALOG_API_KEY": {
      "description": "360dialog API key for webhook verification",
      "required": true
    },
    "AIRTABLE_BASE_ID": {
      "description": "Airtable base ID",
      "required": true
    },
    "AIRTABLE_API_KEY": {
      "description": "Airtable personal access token",
      "required": true
    }
  },
  "rate_limits": {
    "360dialog": "250 messages/second",
    "airtable": "5 requests/second",
    "make_webhook": "no limit (queued)"
  },
  "monitoring": {
    "success_metric": "Messages processed without error",
    "error_threshold": "5% error rate triggers alert",
    "latency_target": "< 2 seconds end-to-end"
  },
  "changelog": [
    {
      "version": "2.0.0",
      "date": "2026-02-14",
      "changes": "Complete rewrite with command extraction, auto-registration, and enriched handoff"
    },
    {
      "version": "1.0.0",
      "date": "2026-01-15",
      "changes": "Initial inbound handler with basic parsing"
    }
  ]
}
