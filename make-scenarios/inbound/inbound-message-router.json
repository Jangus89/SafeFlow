{
  "name": "safeflow-inbound-message-router",
  "description": "Entry point for all inbound WhatsApp messages via 360dialog webhook",
  "version": "1.0.0",
  "trigger": "webhook",
  "flow": {
    "modules": [
      {
        "id": 1,
        "name": "Webhook: 360dialog Inbound",
        "type": "webhook",
        "config": {
          "name": "sf-webhook-inbound",
          "method": "POST",
          "headers_validation": {
            "verify_signature": true,
            "signature_header": "X-Hub-Signature-256",
            "secret_env": "WHATSAPP_WEBHOOK_SECRET"
          },
          "response": {
            "status": 200,
            "body": { "status": "received" }
          }
        },
        "notes": "Immediately responds 200 to prevent 360dialog retries. Signature validation ensures authenticity."
      },
      {
        "id": 2,
        "name": "Router: Message Type",
        "type": "router",
        "config": {
          "routes": [
            {
              "name": "Text Message",
              "condition": "{{1.body.messages[0].type}} == 'text'",
              "target": 3
            },
            {
              "name": "Image Message",
              "condition": "{{1.body.messages[0].type}} == 'image'",
              "target": 4
            },
            {
              "name": "Interactive Reply",
              "condition": "{{1.body.messages[0].type}} == 'interactive'",
              "target": 5
            },
            {
              "name": "Location Message",
              "condition": "{{1.body.messages[0].type}} == 'location'",
              "target": 6
            },
            {
              "name": "Unsupported Type",
              "condition": "true",
              "target": 7
            }
          ]
        }
      },
      {
        "id": 3,
        "name": "Process: Text Message",
        "type": "sequence",
        "modules": [
          {
            "name": "Lookup Tenant",
            "type": "airtable_search",
            "config": {
              "base_id": "{{env.AIRTABLE_BASE_ID}}",
              "table": "Tenants",
              "filter": "{Phone} = '{{1.body.messages[0].from}}'",
              "max_records": 1
            }
          },
          {
            "name": "Check Tenant Exists",
            "type": "router",
            "config": {
              "routes": [
                {
                  "name": "Known Tenant",
                  "condition": "{{length(3.modules[0].result)}} > 0",
                  "target": "classify_intent"
                },
                {
                  "name": "Unknown Tenant",
                  "condition": "true",
                  "target": "registration_flow"
                }
              ]
            }
          },
          {
            "name": "classify_intent",
            "label": "Claude: Classify Intent",
            "type": "http_request",
            "config": {
              "url": "https://api.anthropic.com/v1/messages",
              "method": "POST",
              "headers": {
                "x-api-key": "{{env.ANTHROPIC_API_KEY}}",
                "anthropic-version": "2023-06-01",
                "content-type": "application/json"
              },
              "body": {
                "model": "{{env.CLAUDE_MODEL}}",
                "max_tokens": 1024,
                "temperature": 0.3,
                "system": "{{prompts.system.facilities_classifier}}",
                "messages": [
                  {
                    "role": "user",
                    "content": "Classify this message from tenant {{tenant.name}} at {{tenant.property}}:\n\n{{1.body.messages[0].text.body}}"
                  }
                ]
              }
            }
          },
          {
            "name": "Route by Intent",
            "type": "router",
            "config": {
              "routes": [
                {
                  "name": "Maintenance Request",
                  "condition": "{{classify_intent.intent}} == 'maintenance_request'",
                  "target_scenario": "safeflow-maintenance-create"
                },
                {
                  "name": "Emergency",
                  "condition": "{{classify_intent.intent}} == 'emergency'",
                  "target_scenario": "safeflow-escalation-emergency"
                },
                {
                  "name": "Rent Inquiry",
                  "condition": "{{classify_intent.intent}} == 'rent_inquiry'",
                  "target_scenario": "safeflow-rent-inquiry"
                },
                {
                  "name": "General / Unknown",
                  "condition": "true",
                  "target_scenario": "safeflow-general-response"
                }
              ]
            }
          }
        ]
      },
      {
        "id": 4,
        "name": "Process: Image Message",
        "type": "sequence",
        "notes": "Images are assumed to be maintenance-related. Download media, attach to request.",
        "modules": [
          {
            "name": "Download Media",
            "type": "http_request",
            "config": {
              "url": "{{env.WHATSAPP_API_URL}}/media/{{1.body.messages[0].image.id}}",
              "method": "GET",
              "headers": {
                "Authorization": "Bearer {{env.WHATSAPP_API_KEY}}"
              }
            }
          },
          {
            "name": "Route to Maintenance with Photo",
            "type": "scenario_call",
            "config": {
              "target": "safeflow-maintenance-create",
              "params": {
                "has_photo": true,
                "media_url": "{{download_media.url}}"
              }
            }
          }
        ]
      },
      {
        "id": 5,
        "name": "Process: Interactive Reply",
        "type": "sequence",
        "notes": "Handle button/list replies from previous messages",
        "modules": [
          {
            "name": "Parse Reply",
            "type": "json_parse",
            "config": {
              "source": "{{1.body.messages[0].interactive}}"
            }
          },
          {
            "name": "Route by Reply ID",
            "type": "router",
            "config": {
              "routes": [
                {
                  "name": "Confirm Resolution",
                  "condition": "{{starts_with(reply.id, 'resolve_')}}",
                  "target_scenario": "safeflow-maintenance-resolve"
                },
                {
                  "name": "Schedule Inspection",
                  "condition": "{{starts_with(reply.id, 'inspect_')}}",
                  "target_scenario": "safeflow-inspection-schedule"
                },
                {
                  "name": "Escalate",
                  "condition": "{{starts_with(reply.id, 'escalate_')}}",
                  "target_scenario": "safeflow-escalation-tenant"
                }
              ]
            }
          }
        ]
      },
      {
        "id": 6,
        "name": "Process: Location Message",
        "type": "sequence",
        "notes": "Location shared — match to nearest property",
        "modules": [
          {
            "name": "Match Property",
            "type": "airtable_search",
            "config": {
              "base_id": "{{env.AIRTABLE_BASE_ID}}",
              "table": "Properties",
              "notes": "Airtable doesn't support geo queries — match by tenant's known property"
            }
          }
        ]
      },
      {
        "id": 7,
        "name": "Process: Unsupported Type",
        "type": "sequence",
        "modules": [
          {
            "name": "Send Unsupported Message Reply",
            "type": "http_request",
            "config": {
              "url": "{{env.WHATSAPP_API_URL}}/messages",
              "method": "POST",
              "body": {
                "messaging_product": "whatsapp",
                "to": "{{1.body.messages[0].from}}",
                "type": "text",
                "text": {
                  "body": "Thanks for your message. I can currently process text messages, images, and button replies. Could you please send your request as a text message?"
                }
              }
            }
          }
        ]
      }
    ],
    "error_handler": {
      "type": "global",
      "actions": [
        {
          "name": "Log Error to Airtable",
          "type": "airtable_create",
          "config": {
            "table": "Error Log",
            "fields": {
              "Scenario": "inbound-message-router",
              "Module": "{{error.module}}",
              "Error": "{{error.message}}",
              "Payload": "{{json(1.body)}}",
              "Timestamp": "{{now}}"
            }
          }
        },
        {
          "name": "Send Fallback Response",
          "type": "http_request",
          "config": {
            "url": "{{env.WHATSAPP_API_URL}}/messages",
            "method": "POST",
            "body": {
              "messaging_product": "whatsapp",
              "to": "{{1.body.messages[0].from}}",
              "type": "text",
              "text": {
                "body": "Sorry, I'm having trouble processing your message right now. Your message has been logged and our team will get back to you shortly."
              }
            }
          }
        }
      ]
    }
  },
  "scheduling": {
    "type": "instant",
    "notes": "Triggered by webhook — no scheduling needed"
  }
}
