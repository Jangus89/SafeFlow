{
  "version": "1.0.0",
  "description": "Field mappings between Airtable and Xero",
  "contact_mapping": {
    "description": "Maps Airtable Property Owner to Xero Contact",
    "airtable_table": "Properties",
    "xero_entity": "Contact",
    "fields": {
      "Owner": "Name",
      "Owner Email": "EmailAddress",
      "Owner Phone": "Phones[0].PhoneNumber",
      "Address": "Addresses[0].AddressLine1",
      "City": "Addresses[0].City",
      "Xero Contact ID": "ContactID"
    }
  },
  "invoice_mapping": {
    "description": "Maps completed Maintenance Request to Xero Invoice",
    "airtable_table": "Maintenance Requests",
    "xero_entity": "Invoice",
    "fields": {
      "Reference": "Reference",
      "Cost": "LineItems[0].UnitAmount",
      "Category": "LineItems[0].Description (prefix)",
      "Description": "LineItems[0].Description (body)",
      "Completed Date": "Date"
    },
    "defaults": {
      "Type": "ACCREC",
      "Status": "DRAFT",
      "LineAmountTypes": "Exclusive",
      "DueDateDays": 14,
      "TaxType": "OUTPUT2"
    }
  },
  "account_codes": {
    "description": "Xero account codes for different maintenance categories",
    "maintenance_income": "200",
    "maintenance_expense": "300",
    "category_overrides": {
      "plumbing": "310",
      "electrical": "311",
      "structural": "312",
      "appliance": "313",
      "pest": "314",
      "hvac": "315",
      "security": "316",
      "general": "300"
    }
  },
  "payment_mapping": {
    "description": "Maps Xero payment events back to Airtable",
    "xero_entity": "Payment",
    "airtable_table": "Maintenance Requests",
    "fields": {
      "InvoiceID": "Xero Invoice ID (lookup key)",
      "Status": "Invoice Status → 'Paid'",
      "Date": "Payment Date"
    }
  }
}
