{
  "base_name": "SafeFlow Facilities Management",
  "description": "Production database for WhatsApp-based facilities management system",
  "version": "1.0.0",
  "tables": {
    "Tenants": {
      "description": "All registered tenants in the system",
      "primary_field": "Full Name",
      "fields": [
        { "name": "Full Name", "type": "singleLineText", "required": true },
        { "name": "Phone", "type": "phoneNumber", "required": true, "description": "WhatsApp number in E.164 format (e.g., +64211234567)" },
        { "name": "Email", "type": "email" },
        { "name": "Property", "type": "multipleRecordLinks", "linked_table": "Properties", "required": true },
        { "name": "Unit Number", "type": "singleLineText" },
        { "name": "Lease Start", "type": "date", "date_format": "YYYY-MM-DD" },
        { "name": "Lease End", "type": "date", "date_format": "YYYY-MM-DD" },
        { "name": "Status", "type": "singleSelect", "options": ["Active", "Notice Given", "Past"], "default": "Active" },
        { "name": "Preferred Language", "type": "singleSelect", "options": ["en", "mi", "zh", "hi"], "default": "en" },
        { "name": "Emergency Contact", "type": "singleLineText" },
        { "name": "Emergency Phone", "type": "phoneNumber" },
        { "name": "Notes", "type": "multilineText" },
        { "name": "Registered At", "type": "dateTime", "auto": true },
        { "name": "Last Contact", "type": "dateTime" },
        { "name": "Maintenance Requests", "type": "multipleRecordLinks", "linked_table": "Maintenance Requests", "inverse": true },
        { "name": "Message Count", "type": "count", "linked_field": "Messages" },
        { "name": "Open Requests", "type": "rollup", "linked_table": "Maintenance Requests", "rollup_field": "Status", "formula": "COUNTALL(values, 'New') + COUNTALL(values, 'In Progress')" }
      ],
      "views": [
        { "name": "All Active Tenants", "type": "grid", "filter": "{Status} = 'Active'", "sort": "Full Name ASC" },
        { "name": "By Property", "type": "grid", "group_by": "Property" },
        { "name": "Recently Active", "type": "grid", "sort": "Last Contact DESC", "limit": 50 }
      ]
    },
    "Properties": {
      "description": "Managed properties",
      "primary_field": "Property Name",
      "fields": [
        { "name": "Property Name", "type": "singleLineText", "required": true },
        { "name": "Address", "type": "singleLineText", "required": true },
        { "name": "City", "type": "singleLineText" },
        { "name": "Type", "type": "singleSelect", "options": ["Residential", "Commercial", "Mixed Use"] },
        { "name": "Units", "type": "number", "precision": 0 },
        { "name": "Property Manager", "type": "multipleRecordLinks", "linked_table": "Team Members" },
        { "name": "Owner", "type": "singleLineText" },
        { "name": "Owner Phone", "type": "phoneNumber" },
        { "name": "Owner Email", "type": "email" },
        { "name": "Xero Contact ID", "type": "singleLineText", "description": "Linked Xero contact for invoicing" },
        { "name": "Tenants", "type": "multipleRecordLinks", "linked_table": "Tenants", "inverse": true },
        { "name": "Active Requests", "type": "rollup", "linked_table": "Maintenance Requests", "rollup_field": "Status", "formula": "COUNTALL(values, 'New') + COUNTALL(values, 'In Progress')" },
        { "name": "Notes", "type": "multilineText" },
        { "name": "Key Safe Code", "type": "singleLineText", "description": "SENSITIVE - restrict view access" },
        { "name": "Access Instructions", "type": "multilineText" }
      ],
      "views": [
        { "name": "All Properties", "type": "grid", "sort": "Property Name ASC" },
        { "name": "By Manager", "type": "grid", "group_by": "Property Manager" },
        { "name": "Properties with Open Issues", "type": "grid", "filter": "{Active Requests} > 0" }
      ]
    },
    "Maintenance Requests": {
      "description": "All maintenance/repair requests from tenants",
      "primary_field": "Reference",
      "fields": [
        { "name": "Reference", "type": "singleLineText", "required": true, "description": "Format: MR-YYYYMMDD-XXXX" },
        { "name": "Tenant", "type": "multipleRecordLinks", "linked_table": "Tenants", "required": true },
        { "name": "Property", "type": "lookup", "linked_field": "Tenant", "lookup_field": "Property" },
        { "name": "Category", "type": "singleSelect", "options": ["Plumbing", "Electrical", "Structural", "Appliance", "Pest", "HVAC", "Security", "General"], "required": true },
        { "name": "Urgency", "type": "singleSelect", "options": ["Low", "Medium", "High", "Emergency"], "required": true },
        { "name": "Status", "type": "singleSelect", "options": ["New", "Acknowledged", "In Progress", "Awaiting Parts", "Scheduled", "Completed", "Resolved", "Closed", "Cancelled"], "default": "New" },
        { "name": "Description", "type": "multilineText", "required": true },
        { "name": "Location in Property", "type": "singleLineText" },
        { "name": "Access Instructions", "type": "multilineText" },
        { "name": "Original Message", "type": "multilineText" },
        { "name": "Photos", "type": "multipleAttachments" },
        { "name": "Has Photo", "type": "checkbox" },
        { "name": "Assigned Contractor", "type": "multipleRecordLinks", "linked_table": "Contractors" },
        { "name": "Cost", "type": "currency", "currency_symbol": "$", "precision": 2 },
        { "name": "Invoice Status", "type": "singleSelect", "options": ["Not Invoiced", "Invoiced", "Paid"], "default": "Not Invoiced" },
        { "name": "Xero Invoice ID", "type": "singleLineText" },
        { "name": "Xero Invoice Number", "type": "singleLineText" },
        { "name": "Invoice Date", "type": "dateTime" },
        { "name": "Escalation Level", "type": "number", "precision": 0, "default": 0 },
        { "name": "Last Escalated At", "type": "dateTime" },
        { "name": "Next Escalation At", "type": "dateTime" },
        { "name": "Notes", "type": "multilineText" },
        { "name": "Created", "type": "dateTime", "auto": true },
        { "name": "Updated", "type": "dateTime", "auto": true },
        { "name": "Completed Date", "type": "dateTime" },
        { "name": "Resolution Notes", "type": "multilineText" },
        { "name": "Tenant Satisfaction", "type": "rating", "max": 5 },
        { "name": "Time to Resolve (hours)", "type": "formula", "formula": "IF({Completed Date}, DATETIME_DIFF({Completed Date}, {Created}, 'hours'), '')" }
      ],
      "views": [
        { "name": "Active Requests", "type": "grid", "filter": "AND({Status} != 'Resolved', {Status} != 'Closed', {Status} != 'Cancelled')", "sort": [{ "field": "Urgency", "direction": "desc" }, { "field": "Created", "direction": "asc" }] },
        { "name": "Kanban Board", "type": "kanban", "group_by": "Status" },
        { "name": "By Property", "type": "grid", "group_by": "Property" },
        { "name": "Overdue / Escalated", "type": "grid", "filter": "{Escalation Level} > 0", "sort": "Escalation Level DESC" },
        { "name": "Completed - Uninvoiced", "type": "grid", "filter": "AND({Status} = 'Completed', {Invoice Status} = 'Not Invoiced')" },
        { "name": "Emergency Only", "type": "grid", "filter": "{Urgency} = 'Emergency'" },
        { "name": "This Week", "type": "grid", "filter": "IS_AFTER({Created}, DATEADD(TODAY(), -7, 'days'))" }
      ]
    },
    "Contractors": {
      "description": "Approved maintenance contractors and tradespeople",
      "primary_field": "Company Name",
      "fields": [
        { "name": "Company Name", "type": "singleLineText", "required": true },
        { "name": "Contact Person", "type": "singleLineText" },
        { "name": "Phone", "type": "phoneNumber", "required": true },
        { "name": "Email", "type": "email" },
        { "name": "Specialties", "type": "multipleSelects", "options": ["Plumbing", "Electrical", "Structural", "Appliance", "Pest", "HVAC", "Security", "General"] },
        { "name": "Availability", "type": "singleSelect", "options": ["Available", "Busy", "On Leave", "Inactive"] },
        { "name": "Emergency Available", "type": "checkbox" },
        { "name": "Hourly Rate", "type": "currency", "currency_symbol": "$", "precision": 2 },
        { "name": "Rating", "type": "rating", "max": 5 },
        { "name": "Completed Jobs", "type": "count", "linked_field": "Maintenance Requests" },
        { "name": "Xero Contact ID", "type": "singleLineText" },
        { "name": "Insurance Expiry", "type": "date" },
        { "name": "Notes", "type": "multilineText" }
      ],
      "views": [
        { "name": "Available Contractors", "type": "grid", "filter": "{Availability} = 'Available'" },
        { "name": "By Specialty", "type": "grid", "group_by": "Specialties" },
        { "name": "Emergency Roster", "type": "grid", "filter": "AND({Availability} = 'Available', {Emergency Available} = TRUE())" }
      ]
    },
    "Team Members": {
      "description": "Property management team members",
      "primary_field": "Name",
      "fields": [
        { "name": "Name", "type": "singleLineText", "required": true },
        { "name": "Role", "type": "singleSelect", "options": ["Property Manager", "Senior Manager", "Director", "Admin"] },
        { "name": "Phone", "type": "phoneNumber", "required": true },
        { "name": "Email", "type": "email", "required": true },
        { "name": "Managed Properties", "type": "multipleRecordLinks", "linked_table": "Properties", "inverse": true },
        { "name": "Escalation Level", "type": "number", "precision": 0, "description": "1=first responder, 4=director" },
        { "name": "Active", "type": "checkbox", "default": true },
        { "name": "On Call", "type": "checkbox" }
      ]
    },
    "Conversations": {
      "description": "Active conversation threads with tenants",
      "primary_field": "Conversation ID",
      "fields": [
        { "name": "Conversation ID", "type": "singleLineText", "description": "tenant_phone + timestamp" },
        { "name": "Tenant", "type": "multipleRecordLinks", "linked_table": "Tenants" },
        { "name": "State", "type": "singleSelect", "options": ["Active", "Awaiting Input", "Escalated", "Resolved", "Idle"], "default": "Active" },
        { "name": "Current Intent", "type": "singleLineText" },
        { "name": "Related Request", "type": "multipleRecordLinks", "linked_table": "Maintenance Requests" },
        { "name": "Message Count", "type": "count", "linked_field": "Messages" },
        { "name": "Started At", "type": "dateTime", "auto": true },
        { "name": "Last Activity", "type": "dateTime" },
        { "name": "Context Summary", "type": "multilineText", "description": "Rolling summary for Claude API context" }
      ]
    },
    "Message Log": {
      "description": "All inbound and outbound messages for audit trail",
      "primary_field": "Auto",
      "fields": [
        { "name": "Tenant", "type": "multipleRecordLinks", "linked_table": "Tenants" },
        { "name": "Conversation", "type": "multipleRecordLinks", "linked_table": "Conversations" },
        { "name": "Direction", "type": "singleSelect", "options": ["Inbound", "Outbound", "Both"] },
        { "name": "Inbound Message", "type": "multilineText" },
        { "name": "Outbound Message", "type": "multilineText" },
        { "name": "Intent", "type": "singleLineText" },
        { "name": "Confidence", "type": "percent", "precision": 0 },
        { "name": "Scenario", "type": "singleLineText" },
        { "name": "Claude Model", "type": "singleLineText" },
        { "name": "Claude Tokens Used", "type": "number", "precision": 0 },
        { "name": "Timestamp", "type": "dateTime", "auto": true },
        { "name": "Processing Time (ms)", "type": "number", "precision": 0 }
      ],
      "views": [
        { "name": "Recent Messages", "type": "grid", "sort": "Timestamp DESC", "limit": 100 },
        { "name": "By Tenant", "type": "grid", "group_by": "Tenant" },
        { "name": "Low Confidence", "type": "grid", "filter": "{Confidence} < 0.7", "description": "Messages where Claude was less confident - review for prompt improvement" }
      ]
    },
    "Escalation Log": {
      "description": "Record of all escalation events",
      "primary_field": "Auto",
      "fields": [
        { "name": "Maintenance Request", "type": "multipleRecordLinks", "linked_table": "Maintenance Requests" },
        { "name": "From Level", "type": "number", "precision": 0 },
        { "name": "To Level", "type": "number", "precision": 0 },
        { "name": "Notified", "type": "singleLineText" },
        { "name": "Method", "type": "singleLineText" },
        { "name": "Acknowledged", "type": "checkbox" },
        { "name": "Acknowledged At", "type": "dateTime" },
        { "name": "Timestamp", "type": "dateTime", "auto": true }
      ]
    },
    "Error Log": {
      "description": "System errors for monitoring and debugging",
      "primary_field": "Auto",
      "fields": [
        { "name": "Scenario", "type": "singleLineText" },
        { "name": "Module", "type": "singleLineText" },
        { "name": "Error", "type": "multilineText" },
        { "name": "Payload", "type": "multilineText" },
        { "name": "Related Record", "type": "singleLineText" },
        { "name": "Tenant", "type": "singleLineText" },
        { "name": "Resolved", "type": "checkbox" },
        { "name": "Resolution Notes", "type": "multilineText" },
        { "name": "Timestamp", "type": "dateTime", "auto": true }
      ],
      "views": [
        { "name": "Unresolved Errors", "type": "grid", "filter": "{Resolved} != TRUE()", "sort": "Timestamp DESC" },
        { "name": "By Scenario", "type": "grid", "group_by": "Scenario" },
        { "name": "Last 24 Hours", "type": "grid", "filter": "IS_AFTER({Timestamp}, DATEADD(NOW(), -24, 'hours'))" }
      ]
    },
    "WhatsApp Templates": {
      "description": "Registry of approved WhatsApp message templates",
      "primary_field": "Template Name",
      "fields": [
        { "name": "Template Name", "type": "singleLineText", "required": true },
        { "name": "Category", "type": "singleSelect", "options": ["Marketing", "Utility", "Authentication"] },
        { "name": "Language", "type": "singleSelect", "options": ["en", "mi"], "default": "en" },
        { "name": "Header", "type": "singleLineText" },
        { "name": "Body", "type": "multilineText", "required": true },
        { "name": "Footer", "type": "singleLineText" },
        { "name": "Buttons", "type": "multilineText" },
        { "name": "Parameters", "type": "multilineText", "description": "JSON list of parameter definitions" },
        { "name": "Status", "type": "singleSelect", "options": ["Draft", "Submitted", "Approved", "Rejected"], "default": "Draft" },
        { "name": "360dialog Template ID", "type": "singleLineText" },
        { "name": "Notes", "type": "multilineText" }
      ]
    }
  },
  "relationships": {
    "Tenants → Properties": "Many-to-One (tenant belongs to one property)",
    "Maintenance Requests → Tenants": "Many-to-One (request belongs to tenant)",
    "Maintenance Requests → Contractors": "Many-to-One (request assigned to contractor)",
    "Properties → Team Members": "Many-to-One (property has one manager)",
    "Conversations → Tenants": "Many-to-One (conversation belongs to tenant)",
    "Message Log → Conversations": "Many-to-One (message belongs to conversation)",
    "Escalation Log → Maintenance Requests": "Many-to-One (escalation belongs to request)"
  }
}
