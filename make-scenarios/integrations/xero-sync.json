{
  "name": "safeflow-xero-sync",
  "description": "Scheduled sync between Airtable maintenance records and Xero invoicing",
  "version": "1.0.0",
  "trigger": "schedule",
  "schedule": {
    "interval": 1,
    "unit": "hours",
    "notes": "Runs hourly to sync completed maintenance work to Xero invoices"
  },
  "flow": {
    "modules": [
      {
        "id": 1,
        "name": "Fetch Completed Uninvoiced Work",
        "type": "airtable_search",
        "config": {
          "base_id": "{{env.AIRTABLE_BASE_ID}}",
          "table": "Maintenance Requests",
          "filter": "AND({Status} = 'Completed', {Invoice Status} = 'Not Invoiced', {Cost} > 0)",
          "sort": [{ "field": "Completed Date", "direction": "asc" }],
          "max_records": 10
        }
      },
      {
        "id": 2,
        "name": "Iterator: Process Each Completed Request",
        "type": "iterator",
        "source": "{{1.result}}",
        "modules": [
          {
            "name": "Lookup Xero Contact",
            "type": "http_request",
            "config": {
              "url": "https://api.xero.com/api.xro/2.0/Contacts",
              "method": "GET",
              "headers": {
                "Authorization": "Bearer {{xero_access_token}}",
                "Xero-Tenant-Id": "{{env.XERO_TENANT_ID}}",
                "Accept": "application/json"
              },
              "params": {
                "where": "Name==\"{{item.fields.Property Owner Name}}\""
              }
            }
          },
          {
            "name": "Create Xero Invoice",
            "type": "http_request",
            "config": {
              "url": "https://api.xero.com/api.xro/2.0/Invoices",
              "method": "POST",
              "headers": {
                "Authorization": "Bearer {{xero_access_token}}",
                "Xero-Tenant-Id": "{{env.XERO_TENANT_ID}}",
                "Content-Type": "application/json"
              },
              "body": {
                "Type": "ACCREC",
                "Contact": {
                  "ContactID": "{{lookup_contact.Contacts[0].ContactID}}"
                },
                "Date": "{{formatDate(now, 'YYYY-MM-DD')}}",
                "DueDate": "{{formatDate(addDays(now, 14), 'YYYY-MM-DD')}}",
                "LineAmountTypes": "Exclusive",
                "LineItems": [
                  {
                    "Description": "Maintenance: {{item.fields.Reference}} - {{item.fields.Category}} - {{item.fields.Description}}",
                    "Quantity": 1,
                    "UnitAmount": "{{item.fields.Cost}}",
                    "AccountCode": "{{xero_mappings.maintenance_account_code}}",
                    "TaxType": "OUTPUT2"
                  }
                ],
                "Reference": "{{item.fields.Reference}}",
                "Status": "DRAFT"
              }
            }
          },
          {
            "name": "Update Airtable with Invoice ID",
            "type": "airtable_update",
            "config": {
              "table": "Maintenance Requests",
              "record_id": "{{item.id}}",
              "fields": {
                "Invoice Status": "Invoiced",
                "Xero Invoice ID": "{{create_invoice.Invoices[0].InvoiceID}}",
                "Xero Invoice Number": "{{create_invoice.Invoices[0].InvoiceNumber}}",
                "Invoice Date": "{{now}}"
              }
            }
          }
        ]
      }
    ],
    "error_handler": {
      "type": "per_item",
      "action": "continue",
      "log": {
        "type": "airtable_create",
        "config": {
          "table": "Error Log",
          "fields": {
            "Scenario": "safeflow-xero-sync",
            "Module": "{{error.module}}",
            "Error": "{{error.message}}",
            "Related Record": "{{item.id}}",
            "Timestamp": "{{now}}"
          }
        }
      }
    }
  }
}
