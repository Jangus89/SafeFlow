# SafeFlow - Staging Environment Configuration
# Copy to .env and fill in values

# ─── 360dialog WhatsApp API ───────────────────────────────────────────────────
DIALOG_API_KEY=your_360dialog_staging_api_key
DIALOG_API_URL=https://waba.360dialog.io
WHATSAPP_PHONE_NUMBER_ID=your_staging_phone_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_staging_ba_id

# ─── Make.com ─────────────────────────────────────────────────────────────────
MAKE_API_KEY=your_make_api_key
MAKE_TEAM_ID=your_team_id
MAKE_WEBHOOK_URL_SCENARIO_A=https://hook.eu2.make.com/staging_scenario_a_webhook
MAKE_WEBHOOK_URL_SCENARIO_B=https://hook.eu2.make.com/staging_scenario_b_webhook
MAKE_WEBHOOK_URL_SCENARIO_C=https://hook.eu2.make.com/staging_scenario_c_webhook
MAKE_WEBHOOK_URL_SCENARIO_D=https://hook.eu2.make.com/staging_scenario_d_webhook
MAKE_WEBHOOK_URL_SCENARIO_E=https://hook.eu2.make.com/staging_scenario_e_webhook

# ─── Airtable ─────────────────────────────────────────────────────────────────
AIRTABLE_API_KEY=pat_your_staging_token
AIRTABLE_BASE_ID=appSTAGINGBASEID
AIRTABLE_WEBHOOK_SECRET=your_airtable_webhook_secret

# ─── Anthropic (Claude API) ──────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-staging-key
CLAUDE_MODEL=claude-sonnet-4-5-20250929
CLAUDE_MAX_TOKENS=1500
CLAUDE_TEMPERATURE=0.2

# ─── Xero ─────────────────────────────────────────────────────────────────────
XERO_CLIENT_ID=your_xero_client_id
XERO_CLIENT_SECRET=your_xero_client_secret
XERO_TENANT_ID=your_xero_demo_tenant_id
XERO_REDIRECT_URI=https://staging.safeflow.io/xero/callback

# ─── Notifications ───────────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/staging/channel/webhook
ALERT_EMAIL=staging-alerts@safeflow.io

# ─── Application Settings ────────────────────────────────────────────────────
ENVIRONMENT=staging
LOG_LEVEL=INFO
SLA_CHECK_INTERVAL_MINUTES=15
BACKUP_RETENTION_DAYS=14
MAX_RETRY_ATTEMPTS=3
RATE_LIMIT_DELAY_MS=250
