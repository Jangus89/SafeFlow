{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SafeFlow Airtable Schema Definition",
  "description": "JSON Schema that validates the structure of schema.json itself. This is the schema-of-schemas.",
  "type": "object",
  "required": ["version", "base_name", "tables"],
  "properties": {
    "$schema": {"type": "string"},
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semantic version of the schema"
    },
    "last_updated": {
      "type": "string",
      "format": "date-time"
    },
    "updated_by": {"type": "string"},
    "base_name": {"type": "string", "minLength": 1},
    "base_id": {"type": "string", "pattern": "^app[A-Za-z0-9]+$"},
    "environment": {
      "type": "string",
      "enum": ["production", "staging", "development"]
    },
    "tables": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/definitions/table"}
    },
    "relationships": {
      "type": "array",
      "items": {"$ref": "#/definitions/relationship"}
    },
    "state_machine": {"$ref": "#/definitions/state_machine"},
    "sla_definitions": {"type": "object"},
    "constraints": {"$ref": "#/definitions/constraints"}
  },
  "definitions": {
    "table": {
      "type": "object",
      "required": ["name", "table_id", "fields"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 255},
        "table_id": {"type": "string", "pattern": "^tbl[A-Za-z0-9]+$"},
        "description": {"type": "string"},
        "primary_field": {"type": "string"},
        "icon": {"type": "string"},
        "color": {"type": "string"},
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/definitions/field"}
        },
        "views": {
          "type": "array",
          "items": {"$ref": "#/definitions/view"}
        }
      }
    },
    "field": {
      "type": "object",
      "required": ["name", "type"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 255},
        "field_id": {"type": "string", "pattern": "^fld[A-Za-z0-9]+$"},
        "type": {
          "type": "string",
          "enum": [
            "singleLineText", "multilineText", "email", "url", "phoneNumber",
            "number", "currency", "percent", "rating", "checkbox",
            "singleSelect", "multipleSelects",
            "date", "dateTime",
            "multipleRecordLinks", "lookup", "rollup", "count",
            "formula", "autonumber",
            "multipleAttachments",
            "barcode", "button", "richText",
            "duration", "lastModifiedTime", "createdTime", "lastModifiedBy", "createdBy"
          ]
        },
        "options": {"type": "object"},
        "description": {"type": "string"},
        "required": {"type": "boolean"},
        "readonly": {"type": "boolean"},
        "indexed": {"type": "boolean"},
        "sensitive": {"type": "boolean"},
        "auto": {"type": "boolean"},
        "default": {},
        "validation": {"type": "object"},
        "examples": {"type": "array"}
      }
    },
    "view": {
      "type": "object",
      "required": ["name", "type"],
      "properties": {
        "name": {"type": "string"},
        "type": {
          "type": "string",
          "enum": ["grid", "kanban", "calendar", "gallery", "form", "timeline", "gantt"]
        },
        "filter": {"type": "string"},
        "sort": {},
        "group_by": {"type": "string"},
        "description": {"type": "string"},
        "limit": {"type": "integer"}
      }
    },
    "relationship": {
      "type": "object",
      "required": ["from", "to", "type"],
      "properties": {
        "from": {"type": "string"},
        "to": {"type": "string"},
        "type": {
          "type": "string",
          "enum": ["one-to-many", "many-to-one", "many-to-many"]
        },
        "description": {"type": "string"}
      }
    },
    "state_machine": {
      "type": "object",
      "required": ["table", "field", "initial_state", "terminal_states", "transitions"],
      "properties": {
        "table": {"type": "string"},
        "field": {"type": "string"},
        "initial_state": {"type": "string"},
        "terminal_states": {
          "type": "array",
          "items": {"type": "string"}
        },
        "transitions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["from", "to"],
            "properties": {
              "from": {"type": "string"},
              "to": {
                "type": "array",
                "items": {"type": "string"}
              },
              "description": {"type": "string"}
            }
          }
        }
      }
    },
    "constraints": {
      "type": "object",
      "properties": {
        "max_rows_per_table": {"type": "integer"},
        "archival_threshold_rows": {"type": "integer"},
        "archival_policy": {"type": "string"},
        "sensitive_fields": {
          "type": "array",
          "items": {"type": "string"}
        },
        "unique_fields": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    }
  }
}
