{
  "name": "safeflow-maintenance-create",
  "description": "Handles creation and lifecycle of maintenance requests",
  "version": "1.0.0",
  "trigger": "scenario_call",
  "input_params": {
    "tenant_id": "string - Airtable record ID",
    "message_text": "string - Original message content",
    "classification": "object - Claude classification result",
    "has_photo": "boolean - Whether a photo was attached",
    "media_url": "string|null - URL of attached media"
  },
  "flow": {
    "modules": [
      {
        "id": 1,
        "name": "Extract Request Details",
        "type": "http_request",
        "config": {
          "url": "https://api.anthropic.com/v1/messages",
          "method": "POST",
          "headers": {
            "x-api-key": "{{env.ANTHROPIC_API_KEY}}",
            "anthropic-version": "2023-06-01",
            "content-type": "application/json"
          },
          "body": {
            "model": "{{env.CLAUDE_MODEL}}",
            "max_tokens": 1024,
            "temperature": 0.2,
            "system": "{{prompts.extraction.maintenance_details}}",
            "messages": [
              {
                "role": "user",
                "content": "Extract maintenance request details from this message:\n\n{{input.message_text}}"
              }
            ]
          },
          "expected_response_schema": {
            "category": "string (plumbing|electrical|structural|appliance|pest|general|hvac|security)",
            "urgency": "string (low|medium|high|emergency)",
            "location_in_property": "string",
            "description": "string",
            "access_instructions": "string|null"
          }
        }
      },
      {
        "id": 2,
        "name": "Check for Duplicate Request",
        "type": "airtable_search",
        "config": {
          "base_id": "{{env.AIRTABLE_BASE_ID}}",
          "table": "Maintenance Requests",
          "filter": "AND({Tenant} = '{{input.tenant_id}}', {Status} != 'Resolved', {Status} != 'Closed', {Category} = '{{1.category}}', DATETIME_DIFF(NOW(), {Created}, 'hours') < 24)",
          "max_records": 1
        },
        "notes": "Prevent duplicate requests for same issue within 24h"
      },
      {
        "id": 3,
        "name": "Router: Duplicate Check",
        "type": "router",
        "config": {
          "routes": [
            {
              "name": "Is Duplicate",
              "condition": "{{length(2.result)}} > 0",
              "target": 4
            },
            {
              "name": "New Request",
              "condition": "true",
              "target": 5
            }
          ]
        }
      },
      {
        "id": 4,
        "name": "Handle Duplicate",
        "type": "sequence",
        "modules": [
          {
            "name": "Add Update to Existing Request",
            "type": "airtable_update",
            "config": {
              "table": "Maintenance Requests",
              "record_id": "{{2.result[0].id}}",
              "fields": {
                "Notes": "{{2.result[0].fields.Notes}}\n\n[{{now}}] Tenant follow-up: {{input.message_text}}"
              }
            }
          },
          {
            "name": "Send Duplicate Acknowledgment",
            "type": "http_request",
            "config": {
              "url": "{{env.WHATSAPP_API_URL}}/messages",
              "method": "POST",
              "body": {
                "messaging_product": "whatsapp",
                "to": "{{input.tenant_phone}}",
                "type": "text",
                "text": {
                  "body": "I can see you already have an open request for this issue (Ref: {{2.result[0].fields.Reference}}). I've added your latest message to the existing request. Current status: {{2.result[0].fields.Status}}."
                }
              }
            }
          }
        ]
      },
      {
        "id": 5,
        "name": "Create New Request",
        "type": "sequence",
        "modules": [
          {
            "name": "Generate Reference Number",
            "type": "set_variable",
            "config": {
              "name": "reference",
              "value": "MR-{{formatDate(now, 'YYYYMMDD')}}-{{random(1000, 9999)}}"
            }
          },
          {
            "name": "Create Airtable Record",
            "type": "airtable_create",
            "config": {
              "base_id": "{{env.AIRTABLE_BASE_ID}}",
              "table": "Maintenance Requests",
              "fields": {
                "Reference": "{{reference}}",
                "Tenant": ["{{input.tenant_id}}"],
                "Category": "{{1.category}}",
                "Urgency": "{{1.urgency}}",
                "Location in Property": "{{1.location_in_property}}",
                "Description": "{{1.description}}",
                "Access Instructions": "{{1.access_instructions}}",
                "Original Message": "{{input.message_text}}",
                "Status": "New",
                "Created": "{{now}}",
                "Has Photo": "{{input.has_photo}}"
              }
            }
          },
          {
            "name": "Attach Photo if Present",
            "type": "conditional",
            "condition": "{{input.has_photo}} == true",
            "if_true": {
              "type": "airtable_update",
              "config": {
                "table": "Maintenance Requests",
                "record_id": "{{create_record.id}}",
                "fields": {
                  "Photos": [{ "url": "{{input.media_url}}" }]
                }
              }
            }
          },
          {
            "name": "Generate Confirmation Response",
            "type": "http_request",
            "config": {
              "url": "https://api.anthropic.com/v1/messages",
              "method": "POST",
              "body": {
                "model": "{{env.CLAUDE_MODEL}}",
                "max_tokens": 512,
                "temperature": 0.4,
                "system": "{{prompts.generation.maintenance_confirmation}}",
                "messages": [
                  {
                    "role": "user",
                    "content": "Generate a confirmation message for: Reference {{reference}}, Category: {{1.category}}, Urgency: {{1.urgency}}, Description: {{1.description}}"
                  }
                ]
              }
            }
          },
          {
            "name": "Send Confirmation to Tenant",
            "type": "http_request",
            "config": {
              "url": "{{env.WHATSAPP_API_URL}}/messages",
              "method": "POST",
              "body": {
                "messaging_product": "whatsapp",
                "to": "{{input.tenant_phone}}",
                "type": "interactive",
                "interactive": {
                  "type": "button",
                  "body": {
                    "text": "{{generate_confirmation.content}}"
                  },
                  "action": {
                    "buttons": [
                      {
                        "type": "reply",
                        "reply": {
                          "id": "confirm_{{reference}}",
                          "title": "Looks correct"
                        }
                      },
                      {
                        "type": "reply",
                        "reply": {
                          "id": "edit_{{reference}}",
                          "title": "Need to change"
                        }
                      }
                    ]
                  }
                }
              }
            }
          },
          {
            "name": "Notify Property Manager",
            "type": "conditional",
            "condition": "{{1.urgency}} == 'high' || {{1.urgency}} == 'emergency'",
            "if_true": {
              "type": "http_request",
              "config": {
                "url": "{{env.WHATSAPP_API_URL}}/messages",
                "method": "POST",
                "body": {
                  "messaging_product": "whatsapp",
                  "to": "{{tenant.property_manager_phone}}",
                  "type": "template",
                  "template": {
                    "name": "urgent_maintenance_alert",
                    "language": { "code": "en" },
                    "components": [
                      {
                        "type": "body",
                        "parameters": [
                          { "type": "text", "text": "{{reference}}" },
                          { "type": "text", "text": "{{1.category}}" },
                          { "type": "text", "text": "{{tenant.name}}" },
                          { "type": "text", "text": "{{tenant.property}}" }
                        ]
                      }
                    ]
                  }
                }
              }
            }
          },
          {
            "name": "Log Interaction",
            "type": "airtable_create",
            "config": {
              "table": "Message Log",
              "fields": {
                "Tenant": ["{{input.tenant_id}}"],
                "Direction": "Both",
                "Inbound Message": "{{input.message_text}}",
                "Outbound Message": "{{generate_confirmation.content}}",
                "Intent": "maintenance_request",
                "Scenario": "safeflow-maintenance-create",
                "Timestamp": "{{now}}"
              }
            }
          }
        ]
      }
    ],
    "error_handler": {
      "type": "global",
      "actions": [
        {
          "name": "Log Error",
          "type": "airtable_create",
          "config": {
            "table": "Error Log",
            "fields": {
              "Scenario": "safeflow-maintenance-create",
              "Module": "{{error.module}}",
              "Error": "{{error.message}}",
              "Tenant": "{{input.tenant_id}}",
              "Timestamp": "{{now}}"
            }
          }
        }
      ]
    }
  }
}
